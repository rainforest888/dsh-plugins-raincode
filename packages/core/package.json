{
  "name": "@raincode-dsh/core",
  "version": "0.1.0",
  "description": "Shared raincode gateway adapter core for dsh-plugins-raincode-skill and dsh-plugins-raincode-routing (adapter, wire serialize/translate, SSE, gateway auto-spawn).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "eventsource-parser": "^3.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}