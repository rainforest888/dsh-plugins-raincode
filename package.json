{
  "name": "dsh-plugins-raincode-monorepo",
  "private": true,
  "description": "Monorepo: raincode — the model layer of DeepSeek Harness — as two independently publishable dsh plugins (skill self-evolution network + model auto-routing).",
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/plugin-skill",
    "packages/plugin-routing"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "backend:build": "cargo build --release",
    "backend:test": "cargo test --workspace",
    "backend:clippy": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "license": "MIT"
}
